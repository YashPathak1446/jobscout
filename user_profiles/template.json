  },
  "resume_preferences": {
    "master_resume_path": "data/master_resumes/YOUR_NAME.tex",
    "experiences": {
      "always_include": [],
      "conditional_inclusion": {},
      "never_include": []
    },
    "projects": {
      "always_include": [],
      "high_priority": [],
