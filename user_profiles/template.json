      "never_include": []
    },
    "formatting": {
      "max_bullet_chars_experiences": 280,
      "min_bullet_chars_experiences": 140,
      "max_bullet_chars_projects": 140,
      "min_bullet_chars_projects": 120,
      "target_page_count": 1,
      "max_skill_categories": 6,
      "languages_category_first": true,
      "template": "jakes_resume"
    }
  },
  "agent_preferences": {
    "max_jobs_to_discover": 30,
