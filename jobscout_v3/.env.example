# JobScout V3 Environment Variables
# Copy this file to .env and fill in your API keys

# Google Gemini API (REQUIRED)
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Serper.dev API (REQUIRED for nonHTML web search)
# Get yours at: https://serper.dev/ (2,500 free searches/month)
SERPER_API_KEY=your_serper_api_key_here

# Adzuna API (OPTIONAL - fallback job source)
# Get yours at: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Model Settings (OPTIONAL - defaults work fine)
# PRIMARY_MODEL=gemini-3.0-flash-preview
# SECONDARY_MODEL=gemini-2.5-flash
# FALLBACK_MODEL=gemini-2.0-flash
