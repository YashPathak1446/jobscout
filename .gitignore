*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# Environment variables
.env
.env.local

# IDE
.vscode/
.claude/
.idea/
*.swp
*.swo
*~

# Outputs (run-generated, not source)
outputs/

# Frozen before/after comparison sets for scoring changes.
# Contents stay out (resume content, employer names); the manifest and README
# are committed so a lost baseline is detectable rather than silent.
/baselines/*
!/baselines/README.md
!/baselines/*.manifest.json

# Cache (run-generated, not source)
# Leading slash matters: a bare "cache/" matches at ANY depth, which silently
# swallowed tools/cache/ — llm_cache.py never got committed and every fresh
# clone failed to import the generation agent. Anchor these to the repo root.
/cache/
# LLM prompt-hash response cache
/.cache/

# Master resumes - personal data
data/master_resumes/*.tex
!data/master_resumes/*.example.tex
!data/master_resumes/.gitkeep

# User profiles - personal data
# The durable job store: personal, unbounded, rebuildable by discovery.
data/jobs.db

# The public board's export (R64). Generated, regenerated on every crawl, and
# — more to the point — a file of real job listings. Committing it to a public
# repo would *be* the redistribution act R60 left unresolved, taken by accident
# as a side effect of running a script rather than deliberately.
data/board/

user_profiles/*.json
!user_profiles/*.example.json
!user_profiles/template.json

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# JobScout-specific runtime artifacts
.jobscout_seen.json
applied_jobs.csv

# Debug scripts and one-off run artifacts at repo root
/debug_*.py
/test_serper*.py
/bench_*.py
/analysis_results*.json
/enriched_jobs.json
/test_outputs/

# ADK
.adk/
