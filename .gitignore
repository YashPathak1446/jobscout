# Outputs (run-generated, not source)
outputs/

# Frozen before/after comparison sets for scoring changes.
# Contents stay out (resume content, employer names); the manifest and README
# are committed so a lost baseline is detectable rather than silent.
/baselines/*
!/baselines/README.md
!/baselines/*.manifest.json

# Cache (run-generated, not source)
# Leading slash matters: a bare "cache/" matches at ANY depth, which silently
# swallowed tools/cache/ — llm_cache.py never got committed and every fresh
# clone failed to import the generation agent. Anchor these to the repo root.
/cache/
# LLM prompt-hash response cache
/.cache/

# Master resumes - personal data
# Everything a resume can arrive as, not just the format the author uses.
# This rule was written when a master resume was always a hand-written .tex.
# R38 added PDF and Word import, which writes the upload into this same
# directory — so a stranger's resume was tracked while the author's was
# ignored, and the first `git add -A` would have committed their CV.
data/master_resumes/*.tex
data/master_resumes/*.pdf
data/master_resumes/*.docx
data/master_resumes/*.doc
!data/master_resumes/*.example.tex
!data/master_resumes/.gitkeep

# User profiles - personal data
# The durable job store: personal, unbounded, rebuildable by discovery.
# Every store, not the one that existed when this line was written.
# `data/jobs.db` was ignored by name; `data/runs.db` arrived with R51 four
# months later and nobody added a second line, so a live database holding the
# author's own run history — profile name, local filesystem paths, timestamps
# — was tracked while its twin was not. Both are built by CREATE TABLE IF NOT
# EXISTS; neither ever needed to be in the repo.
data/*.db


user_profiles/*.json
!user_profiles/*.example.json
!user_profiles/template.json

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# JobScout-specific runtime artifacts
.jobscout_seen.json
applied_jobs.csv

# Debug scripts and one-off run artifacts at repo root
/debug_*.py
/test_serper*.py
/bench_*.py
/analysis_results*.json
/enriched_jobs.json
/test_outputs/

# ADK
.adk/

# Fixtures staged into the dev server to drive a real upload through the
# browser. Never part of a build.
web/public/_fixture_*
